    <!-- 
        Liquibase Master Changelog for Be New Application
        
        This file references all migration files in the correct order.
        Migrations are executed sequentially based on their timestamp prefixes.
        
        Migration Order:
        1. Schema and roles setup
        2. Core tables (app_user)
        3. Template tables (template, template_task)
        4. Onboarding tables (onboarding_process, onboarding_task)
        5. Foreign key indexes
        6. Search indexes
        7. Composite indexes
        
        Each migration file contains:
        - Detailed comments explaining purpose and design decisions
        - Proper rollback commands
        - Table and column comments for documentation
        
        Run migrations using:
        - Liquibase CLI: liquibase update
        - Spring Boot: auto-runs on application startup
    -->

    <!-- Migration 1: Create schema and database roles -->
    <include file="migrations/20251103100000_create_schema_and_roles.sql" relativeToChangelogFile="true"/>
    
    <!-- Migration 2: Create app_user table -->
