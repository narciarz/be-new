    <!-- Migration 3: Create template tables -->
    <include file="migrations/20251103100002_create_template_tables.sql" relativeToChangelogFile="true"/>
    
    <!-- Migration 4: Create onboarding tables -->
    <include file="migrations/20251103100003_create_onboarding_tables.sql" relativeToChangelogFile="true"/>
    
    <!-- Migration 5: Create foreign key indexes -->
    <include file="migrations/20251103100004_create_foreign_key_indexes.sql" relativeToChangelogFile="true"/>
    
    <!-- Migration 6: Create search indexes -->
